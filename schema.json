{
  "base": {
    "name": "GMAR PROJECT - ERP AI",
    "note": "Replace with your own base ID after import; these IDs are illustrative from the original build."
  },
  "tables": {
    "Invoices": {
      "fields": {
        "InvoiceNumber": "singleLineText (e.g. INV-0001, auto-generated)",
        "CustomerId": "singleLineText",
        "Amount": "number (net, before VAT)",
        "VatAmount": "number (auto-calculated: 17% before 2025-01-01, 18% after)",
        "Total": "number (Amount + VatAmount)",
        "Status": "singleLineText (New / Invalid / Ready / Issued)",
        "PdfUrl": "url (Google Drive link, set by InvoiceMaker)",
        "Created": "createdTime"
      }
    },
    "Leads": {
      "fields": {
        "Name": "singleLineText",
        "Email": "email",
        "Company": "singleLineText",
        "Status": "singleLineText (New / Contacted / Replied / Qualified / Dead)",
        "Created": "createdTime"
      }
    },
    "Products": {
      "fields": {
        "Name": "singleLineText",
        "Category": "singleLineText",
        "Price": "number",
        "Description": "multilineText",
        "InStock": "checkbox"
      }
    },
    "Tasks": {
      "fields": {
        "Title": "singleLineText",
        "Status": "singleLineText (Open / Done)"
      }
    }
  }
}
